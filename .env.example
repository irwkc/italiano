# Teacher cabinet password (web login /aula/login)
AULA_PASSWORD=

# Long random string — signs web cookies and mobile access tokens.
# Required in production. Generate e.g.: openssl rand -base64 48
SESSION_SECRET=

# Public site origin (no trailing slash). Used in invite/confirm emails and absolute media URLs.
APP_URL=https://giacomoschiavon.ru

# Postgres (compose sets this on the VPS)
DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/DBNAME
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Outbound mail for invite email confirmation (Mail.ru example)
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=giacomo_noreply@mail.ru
SMTP_PASS=
SMTP_FROM=giacomo_noreply@mail.ru

# Optional later — APNs push send (registration works without these)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=ru.giacomoschiavon.aula
# APNS_P8=          # contents of AuthKey_XXX.p8 (never commit)
